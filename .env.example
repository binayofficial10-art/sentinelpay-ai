# Optional. When unset or unavailable, SentinelPay uses its rule-based fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Leave empty when FastAPI serves the frontend. For a separate frontend, use its HTTPS origin.
CORS_ALLOWED_ORIGINS=
# Public/non-secret. Leave empty for the included same-origin frontend; otherwise use the API HTTPS origin.
FRONTEND_API_BASE_URL=
# Required on Vercel for authentication, persistent history, shared rate limits, and audit logs.
DATABASE_URL=your_postgresql_connection_string_here
# Required on Vercel: secret used only to HMAC request-source identifiers for rate limits/audit events.
SECURITY_HASH_SECRET=
# Shared database-backed fixed-window limits. Values are positive integers.
RATE_LIMIT_REGISTER_MAX_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_TRANSACTION_CHECK_MAX_REQUESTS=30
RATE_LIMIT_TRANSACTION_CHECK_WINDOW_SECONDS=60
RATE_LIMIT_AUTHENTICATED_MAX_REQUESTS=120
RATE_LIMIT_AUTHENTICATED_WINDOW_SECONDS=60
